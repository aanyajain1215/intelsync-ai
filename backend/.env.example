# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lead_verification?appName=<app-name>

# JWT secret — use a strong random string in production
JWT_SECRET=your_jwt_secret_here

# Server port
PORT=5000

# Python enrichment pipeline URL
PYTHON_API_URL=http://localhost:8000/enrich
