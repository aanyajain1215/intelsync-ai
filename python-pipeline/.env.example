# MongoDB Atlas connection string (same cluster as backend)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lead_verification?appName=<app-name>

# Groq API key — https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Knowledge Graph API key — https://console.cloud.google.com
GOOGLE_KG_API_KEY=your_google_kg_api_key_here

# Serper API key — https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
